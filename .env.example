# ===========================================
# CONTENT CAVE - Variaveis de Ambiente
# ===========================================
# Copie este arquivo para .env.local e preencha os valores
# cp .env.example .env.local

# Anthropic API (obrigatorio)
ANTHROPIC_API_KEY=sua-api-key-aqui

# NextAuth (obrigatorio para login funcionar)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=gere-um-secret-com-openssl-rand-base64-32

# Stripe (opcional - necessario para pagamentos)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
